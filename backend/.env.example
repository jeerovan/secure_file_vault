# Database
DATABASE_URL=postgres://jeerovan@localhost:5432/fife

# Authentication
SUPABASE_KEY=<KEY>
SUPABASE_URL=<URL>
NEON_JWKS=<JWKS_URL>

# RevenueCat
REVENUECAT_SECRET_KEY=<SECRET_KEY>
# Include the complete value expected in the Authorization header (for example, Bearer <TOKEN>).
REVENUECAT_WEBHOOK_SECRET=<AUTHORIZATION_HEADER_VALUE>

# FCM maintenance API authentication
FCM_KEY=<RANDOM_SECRET>

# Local integration testing (development server only)
LOCAL_TEST_AUTH_ENABLED=false
LOCAL_TEST_AUTH_TOKEN=<RANDOM_LOCAL_TOKEN>
LOCAL_TEST_USER_ID=local-integration-user
LOCAL_TEST_EMAIL=jeevan@jeero.one

# Enable managed-upload negotiation/new allocations only after compatibility checks.
# Disabling preserves retries, completion, reporting and cleanup of accepted uploads.
MANAGED_UPLOADS_ENABLED=false

# UTC timestamp after ALL upload issuers use durable expiry accounting.
# Leave empty if unknown. Historical B2 grants drain for 24h (+1m grace),
# S3 grants for 1h (+1m), measured once from this timestamp. Afterwards,
# reset uses 15m or a longer recorded capability expiry, then verified deletion.
# Do not backdate this timestamp on an existing deployment.
RECOVERY_UPLOAD_ACCOUNTING_SINCE=

# Provider inputs for explicit local client/backend integration tests.
# Keep only fields requested by the client here. Discovered metadata belongs
# in each user's credential JSON in the database, never in this file.

# Backblaze B2: the client asks only for Key ID and Application Key.
# Use a standard application key: Key ID = S3 access key; Application Key = S3 secret.
# Use a key restricted to one bucket, as required by the client connection flow.
B2_KEY_ID=
B2_APPLICATION_KEY=

# IDrive E2: endpoint is derived as https://s3.<region>.idrivee2.com.
E2_REGION=
E2_BUCKET_NAME=
E2_ACCESS_KEY_ID=
E2_SECRET_ACCESS_KEY=

# Cloudflare R2: region is auto; endpoint is derived from the account ID.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Oracle Object Storage: use Customer Secret Key credentials for S3 access.
# Endpoint is https://<namespace>.compat.objectstorage.<region>.oraclecloud.com.
OCI_NAMESPACE=
OCI_REGION=
OCI_BUCKET_NAME=
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=

# Generic S3 compatible: public HTTPS endpoint and the provider's signing region.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
